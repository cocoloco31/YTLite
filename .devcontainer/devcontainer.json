// Devcontainer for YTLite — cleaned and made robust for Debian base image
{
  "name": "YTLite Dev Container",

  // Base image (Debian Bullseye) — many features expect Debian/Ubuntu tooling
  "image": "mcr.microsoft.com/devcontainers/base:bullseye",

  // Common features that work on Debian: Node (LTS), Docker-in-Docker support, kubectl+helm
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "enableNonRootDocker": "true", "moby": "true" },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "version": "latest", "helm": "latest", "minikube": "none" },
    "./local-features/copy-kube-config": {},
    "ghcr.io/devcontainers-extra/features/act:1": {}
  },

  // Keep the existing env flag for kube syncing
  "remoteEnv": {
    "SYNC_LOCALHOST_KUBECONFIG": "true"
  },

  // Run the helper script that exists in the repo if present
  "initializeCommand": "cd .devcontainer && bash ensure-mount-sources",

  // Helpful default post-create step: install dependencies if a JS project
  "postCreateCommand": "bash -lc 'if [ -f package.json ]; then (npm ci || npm install); fi'",

  // Common forwarded ports (adjust as needed)
  "forwardPorts": [3000, 8080, 9229],

  "mounts": [
    {
      "source": "${env:HOME}${env:USERPROFILE}/.kube",
      "target": "/usr/local/share/kube-localhost",
      "type": "bind"
    },
    {
      "source": "${env:HOME}${env:USERPROFILE}/.minikube",
      "target": "/usr/local/share/minikube-localhost",
      "type": "bind"
    }
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.vscode-github-actions",
        "eamodio.gitlens",
        "ms-vsliveshare.vsliveshare",
        "ms-vscode-remote.remote-containers"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        }
      }
    }
  },

  "onCreateCommand": "bash -lc 'npm run setup || true',",
  "remoteUser": "vscode"
}
